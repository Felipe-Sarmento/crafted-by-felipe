{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "openrouter": {
      "options": {
        "apiKey": "{file:openrouter.key}"
      }
    }
  },

  "instructions": ["AGENTS.md"],

  "permission": {
    "edit": "allow",
    "read": "allow",
    "glob": "allow",
    "grep": "allow",
    "list": "allow",
    "todowrite": "allow",
    "question": "allow",
    "webfetch": "allow",
    "task": "allow",
    "external_directory": {
      "*": "allow"
    },
    "bash": {
      "*": "ask",
      "pnpm *": "allow",
      "npm *": "allow",
      "npx *": "allow",
      "git *": "allow",
      "ls *": "allow",
      "mkdir *": "allow",
      "node *": "allow",
      "cp *": "allow",
      "mv *": "allow",
      "rm *": "deny"
    }
  }
}
